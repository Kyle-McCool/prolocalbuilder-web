# Resend — transactional email for the quote form (app/api/quote/route.ts).
# Copy this file to .env.local and fill in your key. .env.local is gitignored.

# Required. Get it from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. "From" address — must be on a domain verified in Resend.
# Defaults to "ProLocalBuilder <quotes@prolocalbuilder.com>".
# QUOTE_FROM_EMAIL=ProLocalBuilder <quotes@prolocalbuilder.com>

# Optional. Inbox that receives the leads. Defaults to site.contact.email
# (hello@prolocalbuilder.com).
# QUOTE_TO_EMAIL=hello@prolocalbuilder.com
